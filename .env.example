# Copia este archivo como .env.local y completa los valores.
# En Vercel se agregan con: vercel env add DATABASE_URL / vercel env add GEMINI_API_KEY

# Postgres en la nube (Neon) — https://neon.tech -> Project -> Connection string
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Google AI Studio (capa gratuita) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Correos por SMTP (Brevo u otro) — opcionales: sin ellos la app usa solo la campana
# Brevo -> Perfil -> SMTP & API -> SMTP (host smtp-relay.brevo.com, puerto 587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Correo VERIFICADO en Brevo que aparecerá como remitente
CORREO_REMITENTE=
